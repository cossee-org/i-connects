# Copy to `.env` and edit. `.env` is git-ignored.

# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ----
# Inside Docker network, host = "db". For local (non-docker) dev, use "localhost".
DATABASE_URL=postgres://iconnects:iconnects@db:5432/iconnects

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
# Required in production: docker-compose.prod.yml adds --requirepass to the
# redis service and refuses to start ("required variable REDIS_PASSWORD is
# missing a value") if this is unset or empty. Put the same password in the
# three redis:// URLs above as redis://:<password>@redis:6379/0. Leave unset
# for local dev without auth.
REDIS_PASSWORD=

# ---- Email ----
# Must be "Display Name <address@example.com>" — the angle brackets are
# required. Without them (e.g. "i-connects noreply@iconnects.local"), the
# whole string including the space is read as the address, which then
# mismatches the SMTP-authenticated account and gets outgoing mail
# rejected by the recipient (a DKIM/alignment failure with Gmail).
# `manage.py check` warns at deploy time if this is malformed.
DEFAULT_FROM_EMAIL=i-connects <noreply@iconnects.local>

# Absolute base URL (scheme + host, no trailing slash) used to build links
# in emails sent from Celery tasks (invitations, join requests, digests),
# which have no HTTP request to derive a domain from. Required in
# production — left unset, those emails silently link to a bare relative
# path like "/invites/<code>/" instead of a full URL.
SITE_URL=http://localhost:8000

# ---- Postgres (used by the db service in docker-compose) ----
POSTGRES_DB=iconnects
POSTGRES_USER=iconnects
POSTGRES_PASSWORD=iconnects
